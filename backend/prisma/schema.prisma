generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           Int      @id @default(autoincrement())
  mobileNumber String?  @unique
  email        String   @unique
  password     String?
  isVerified   Boolean  @default(false)
  isBlocked    Boolean  @default(false)
  isDeleted    Boolean  @default(false)
  role         Role     @default(USER)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  profile                 Profile?
  emailVerificationTokens EmailVerificationToken[]
  partnerPreference       PartnerPreference?
  profileSwipes           ProfileSwipe[]           @relation("UserSwipes")
}

model Profile {
  id     Int  @id @default(autoincrement())
  userId Int  @unique
  user   User @relation(fields: [userId], references: [id])

  name          String?
  gender        Gender?
  dateOfBirth   DateTime?
  maritalStatus MaritalStatus?
  heightCm      Int?

  religion     String?
  motherTongue String?

  city    String?
  state   String?
  country String?

  lastLocationLat Float?
  lastLocationLng Float?

  highestEducation String?
  occupation       String?
  annualIncome     Int?
  bio              String?

  languages            String[]

  childrenStatus       ChildrenStatus?
  emotionalReadiness   EmotionalReadiness?
  lookingFor           LookingFor?
  relationshipTimeline RelationshipTimeline?
  smokingHabit         SmokingHabit?
  drinkingHabit        DrinkingHabit?

  profileCompletion Int           @default(10)
  profileStatus     ProfileStatus @default(INCOMPLETE)

  hasCompletedBasicDetails      Boolean       @default(false)
  hasCompletedPartnerPreference Boolean       @default(false)
  hasCompletedImageUpload       Boolean       @default(false)
  selfieUrl                     String?
  leftSelfieUrl                 String?
  rightSelfieUrl                String?
  selfieStatus                  SelfieStatus?

  images     UserImage[]
  answers    UserAnswer[]
  swipesOnMe ProfileSwipe[] @relation("ProfileMatches")

  @@map("profiles")
}

model PartnerPreference {
  id               Int             @id @default(autoincrement())
  userId           Int             @unique
  user             User            @relation(fields: [userId], references: [id])
  ageFrom          Int?
  ageTo            Int?
  heightFrom       Int?
  heightTo         Int?
  maritalStatus    MaritalStatus[]
  religion         String[]
  motherTongue     String[]
  highestEducation String[]
  occupation       String[]
  annualIncomeFrom Int?
  annualIncomeTo   Int?

  @@map("partner_preferences")
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum MaritalStatus {
  NEVER_MARRIED
  AWATING_DIVORCE
  DIVORCED
  WIDOWED
  ANNULLED
  LEGALLY_SEPARATED
}

enum ChildrenStatus {
  LIVING_WITH_ME
  NOT_LIVING_WITH_ME
  NO_CHILDREN
}

enum EmotionalReadiness {
  YES
  MOSTLY
  NOT_SURE
}

enum LookingFor {
  MARRIAGE
  LONG_TERM_RELATIONSHIP
  SERIOUS_COMPANIONSHIP
}

enum RelationshipTimeline {
  ZERO_TO_SIX_MONTHS
  SIX_TO_TWELVE_MONTHS
  NO_FIXED_TIMELINE
}

enum SmokingHabit {
  NO
  OCCASIONALLY
  YES
}

enum DrinkingHabit {
  NO
  SOCIALLY
  YES
}

model EmailVerificationToken {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
  token     String   @unique
  expiresAt DateTime
  isUsed    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([token])
  @@map("email_verification_tokens")
}

enum SelfieStatus {
  PENDING
  APPROVED
  REJECTED
}

model ProfileSection {
  id        Int               @id @default(autoincrement())
  key       String            @unique // e.g. "emotional_maturity"
  title     String
  orderNo   Int               @default(0)
  isPrimary Boolean           @default(false)
  questions ProfileQuestion[]

  @@map("profile_sections")
}

model ProfileQuestion {
  id         Int            @id @default(autoincrement())
  sectionId  Int
  section    ProfileSection @relation(fields: [sectionId], references: [id])
  question   String
  answerType AnswerType
  options    Json? // JSONB for choices/options
  minWords   Int?
  weight     Int            @default(1)
  isRequired Boolean        @default(true)
  orderNo    Int            @default(0)
  isActive   Boolean        @default(true)
  answers    UserAnswer[]

  @@map("profile_questions")
}

model UserAnswer {
  id         Int             @id @default(autoincrement())
  profileId  Int
  profile    Profile         @relation(fields: [profileId], references: [id])
  questionId Int
  question   ProfileQuestion @relation(fields: [questionId], references: [id])
  answer     Json // JSONB for the answer content
  score      Int?
  createdAt  DateTime        @default(now())

  @@unique([profileId, questionId]) // One answer per question per user
  @@map("user_answers")
}

enum AnswerType {
  TEXT
  SINGLE_CHOICE
  MULTI_CHOICE
  RATING
  BOOLEAN
}

enum Role {
  USER
  ADMIN
  SUPER_ADMIN
}

model Admin {
  id        Int      @id @default(autoincrement())
  username  String   @unique
  password  String
  role      Role     @default(ADMIN)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model UserImage {
  id        Int      @id @default(autoincrement())
  profileId Int
  profile   Profile  @relation(fields: [profileId], references: [id])
  imageUrl  String
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("user_images")
}

enum ProfileStatus {
  INCOMPLETE
  ONBOARDING_COMPLETED
  COMPLETED
}

enum SwipeAction {
  LEFT
  RIGHT
  UP
}

model ProfileSwipe {
  id              Int         @id @default(autoincrement())
  userId          Int
  user            User        @relation("UserSwipes", fields: [userId], references: [id])
  targetProfileId Int
  targetProfile   Profile     @relation("ProfileMatches", fields: [targetProfileId], references: [id])
  action          SwipeAction
  createdAt       DateTime    @default(now())

  @@map("profile_swipes")
}
