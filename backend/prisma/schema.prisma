generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── User Management ─────────────────────────────────────────────────────────

model User {
  id           Int      @id @default(autoincrement())
  mobileNumber String?  @unique
  email        String   @unique
  password     String?
  isVerified   Boolean  @default(false)
  isBlocked    Boolean  @default(false)
  isDeleted    Boolean  @default(false)
  role         Role     @default(USER)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  profile           Profile?
  partnerPreference PartnerPreference?
  profileSwipes     ProfileSwipe[]     @relation("UserSwipes")
  subscriptions     UserSubscription[]
  userFeature       UserFeature?

  conversationsAsOne Conversation[] @relation("ConversationUserOne")
  conversationsAsTwo Conversation[] @relation("ConversationUserTwo")
  chatMessages       ChatMessage[]

  @@map("users")
}

model Profile {
  id     Int  @id @default(autoincrement())
  userId Int  @unique
  user   User @relation(fields: [userId], references: [id])

  name          String?
  gender        Gender?
  dateOfBirth   DateTime?
  maritalStatus MaritalStatus?
  heightCm      Int?

  religion     String?
  motherTongue String?

  city    String?
  state   String?
  country String?

  lastLocationLat Float?
  lastLocationLng Float?

  highestEducation String?
  occupation       String?
  annualIncome     Int?
  bio              String?

  languages String[]

  childrenStatus       ChildrenStatus?
  emotionalReadiness   EmotionalReadiness?
  lookingFor           LookingFor?
  relationshipTimeline RelationshipTimeline?
  smokingHabit         SmokingHabit?
  drinkingHabit        DrinkingHabit?

  profileCompletion Int           @default(10)
  profileStatus     ProfileStatus @default(INCOMPLETE)

  hasCompletedBasicDetails      Boolean       @default(false)
  hasCompletedPartnerPreference Boolean       @default(false)
  hasCompletedImageUpload       Boolean       @default(false)
  selfieUrl                     String?
  leftSelfieUrl                 String?
  rightSelfieUrl                String?
  selfieStatus                  SelfieStatus?

  images     UserImage[]
  answers    UserAnswer[]
  swipesOnMe ProfileSwipe[] @relation("ProfileMatches")

  @@map("profiles")
}

model PartnerPreference {
  id               Int             @id @default(autoincrement())
  userId           Int             @unique
  user             User            @relation(fields: [userId], references: [id])
  ageFrom          Int?
  ageTo            Int?
  heightFrom       Int?
  heightTo         Int?
  maritalStatus    MaritalStatus[]
  religion         String[]
  motherTongue     String[]
  highestEducation String[]
  occupation       String[]
  annualIncomeFrom Int?
  annualIncomeTo   Int?

  @@map("partner_preferences")
}

model UserImage {
  id        Int      @id @default(autoincrement())
  profileId Int
  profile   Profile  @relation(fields: [profileId], references: [id])
  imageUrl  String
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("user_images")
}

model ProfileSwipe {
  id              Int         @id @default(autoincrement())
  userId          Int
  user            User        @relation("UserSwipes", fields: [userId], references: [id])
  targetProfileId Int
  targetProfile   Profile     @relation("ProfileMatches", fields: [targetProfileId], references: [id])
  action          SwipeAction
  createdAt       DateTime    @default(now())

  @@map("profile_swipes")
}

// ─── Survey & compatibility ──────────────────────────────────────────────────

model ProfileSection {
  id        Int               @id @default(autoincrement())
  key       String            @unique // e.g. "emotional_maturity"
  title     String
  orderNo   Int               @default(0)
  isPrimary Boolean           @default(false)
  questions ProfileQuestion[]

  @@map("profile_sections")
}

model ProfileQuestion {
  id         Int            @id @default(autoincrement())
  sectionId  Int
  section    ProfileSection @relation(fields: [sectionId], references: [id])
  question   String
  answerType AnswerType
  options    Json? // JSONB for choices/options
  minWords   Int?
  weight     Int            @default(1)
  isRequired Boolean        @default(true)
  orderNo    Int            @default(0)
  isActive   Boolean        @default(true)
  answers    UserAnswer[]

  @@map("profile_questions")
}

model UserAnswer {
  id         Int             @id @default(autoincrement())
  profileId  Int
  profile    Profile         @relation(fields: [profileId], references: [id])
  questionId Int
  question   ProfileQuestion @relation(fields: [questionId], references: [id])
  answer     Json // JSONB for the answer content
  score      Int?
  createdAt  DateTime        @default(now())

  @@unique([profileId, questionId]) // One answer per question per user
  @@map("user_answers")
}

// ─── Administration ──────────────────────────────────────────────────────────

model Admins {
  id        Int      @id @default(autoincrement())
  username  String   @unique
  password  String
  role      Role     @default(ADMIN)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("admins")
}

// ─── Subscription Plans ──────────────────────────────────────────────────────

model SubscriptionPlan {
  id                Int                @id @default(autoincrement())
  name              String             @unique // FREE, PREMIUM, GOLD
  price             Int // price in paise (₹1 = 100 paise)
  durationDays      Int
  isActive          Boolean            @default(true)
  isMostPopular     Boolean            @default(false)
  features          PlanFeature[]
  userSubscriptions UserSubscription[]
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@map("subscription_plans")
}

model PlanFeature {
  id         Int              @id @default(autoincrement())
  planId     Int
  plan       SubscriptionPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  featureKey String
  limit      String // e.g. "50", "UNLIMITED", "true"
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  @@unique([planId, featureKey]) // one limit per feature per plan
  @@map("plan_features")
}

model UserSubscription {
  id        Int                @id @default(autoincrement())
  userId    Int
  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  planId    Int
  plan      SubscriptionPlan   @relation(fields: [planId], references: [id], onDelete: Cascade)
  startDate DateTime           @default(now())
  endDate   DateTime
  status    SubscriptionStatus @default(ACTIVE)
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  @@index([userId, status])
  @@map("user_subscriptions")
}

model UserFeature {
  id     Int  @id @default(autoincrement())
  userId Int  @unique
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Boolean Features
  canAudioCall         Boolean @default(false)
  canVideoCall         Boolean @default(false)
  canSendMessage       Boolean @default(false)
  isProfileBlurEnabled Boolean @default(false)

  // Interest Limits
  maxInterests Int @default(0)
  interests    Int @default(0)

  // Video Call Minutes
  maxVideoCallMinutes Int @default(0)
  videoCallMinutes    Int @default(0)

  // Audio Call Minutes
  maxAudioCallMinutes Int @default(0)
  audioCallMinutes    Int @default(0)

  // Message Limits
  maxMessages Int @default(0)
  messages    Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("user_features")
}

model ImageAssets {
  id           Int                @id @default(autoincrement())
  section      ImageAssetsSection
  title        String
  imageUrl     String
  altText      String?
  redirectUrl  String?
  displayOrder Int                @default(0)
  isActive     Boolean            @default(true)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  @@index([section, isActive, displayOrder])
  @@map("image_assets")
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum Role {
  USER
  ADMIN
  SUPER_ADMIN
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum MaritalStatus {
  NEVER_MARRIED
  AWATING_DIVORCE
  DIVORCED
  WIDOWED
  ANNULLED
  LEGALLY_SEPARATED
}

enum ChildrenStatus {
  LIVING_WITH_ME
  NOT_LIVING_WITH_ME
  NO_CHILDREN
}

enum EmotionalReadiness {
  YES
  MOSTLY
  NOT_SURE
}

enum LookingFor {
  MARRIAGE
  LONG_TERM_RELATIONSHIP
  SERIOUS_COMPANIONSHIP
}

enum RelationshipTimeline {
  ZERO_TO_SIX_MONTHS
  SIX_TO_TWELVE_MONTHS
  NO_FIXED_TIMELINE
}

enum SmokingHabit {
  NO
  OCCASIONALLY
  YES
}

enum DrinkingHabit {
  NO
  SOCIALLY
  YES
}

enum SelfieStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ProfileStatus {
  INCOMPLETE
  ONBOARDING_COMPLETED
  COMPLETED
}

enum AnswerType {
  TEXT
  SINGLE_CHOICE
  MULTI_CHOICE
  RATING
  BOOLEAN
}

enum SwipeAction {
  LEFT
  RIGHT
  UP
}

enum SubscriptionStatus {
  ACTIVE
  INACTIVE
  CANCELLED
  EXPIRED
}

enum InteractionState {
  NONE
  INTEREST_SENT
  INTEREST_RECEIVED
  MATCHED
}

enum ImageAssetsSection {
  ONBOARDING_SCREEN
  BANNERS
  ADS
  ONBOARDING
  ICON
}

enum MessageType {
  TEXT
  IMAGE
  AUDIO
  VIDEO
}

// ─── Chat ───────────────────────────────────────────────────────────────────

model Conversation {
  id        Int           @id @default(autoincrement())
  userOneId Int
  userTwoId Int
  userOne   User          @relation("ConversationUserOne", fields: [userOneId], references: [id])
  userTwo   User          @relation("ConversationUserTwo", fields: [userTwoId], references: [id])
  messages  ChatMessage[]
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@unique([userOneId, userTwoId])
  @@map("conversations")
}

model ChatMessage {
  id             Int          @id @default(autoincrement())
  conversationId Int
  conversation   Conversation @relation(fields: [conversationId], references: [id])
  senderId       Int
  sender         User         @relation(fields: [senderId], references: [id])
  content        String
  messageType    MessageType  @default(TEXT)
  zegoMessageId  String?
  createdAt      DateTime     @default(now())

  @@index([conversationId, createdAt])
  @@map("chat_messages")
}
