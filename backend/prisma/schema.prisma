generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                    Int                  @id @default(autoincrement())
  mobileNumber          String?              @unique
  email                 String               @unique
  password              String?
  isVerified            Boolean              @default(false)
  isBanned              Boolean              @default(false)
  isSuspended           Boolean              @default(false)
  isFoundingMember      Boolean              @default(false)
  foundingMemberSince   DateTime?
  bannedAt              DateTime?
  suspendedAt           DateTime?
  isDeleted             Boolean                @default(false)
  isDeleteRequested     Boolean                @default(false)
  deleteRequestedAt     DateTime?
  deleteRequestStatus   DeletionRequestStatus?
  role                  Role                   @default(USER)
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
  chatMessages          ChatMessage[]
  conversationsAsOne    Conversation[]       @relation("ConversationUserOne")
  conversationsAsTwo    Conversation[]       @relation("ConversationUserTwo")
  receivedImageRequests ImageAccessRequest[] @relation("ReceivedRequests")
  sentImageRequests     ImageAccessRequest[] @relation("SentRequests")
  partnerPreference     PartnerPreference?
  privacySettings       PrivacySettings?
  profileSwipes         ProfileSwipe[]       @relation("UserSwipes")
  profile               Profile?
  userFeature           UserFeature?
  subscriptions         UserSubscription[]
  transactionHistory    TransactionHistory[]
  socialAccounts        SocialAccount[]

  reportsSubmitted UserReport[]          @relation("ReportedBy")
  reportsReceived  UserReport[]          @relation("ReportTarget")
  moderationLogs   ModerationActionLog[] @relation("UserModerationLogs")
  blockedUsers     UserBlock[]           @relation("BlockerUser")
  blockedBy        UserBlock[]           @relation("BlockedUser")
  deviceTokens     DeviceToken[]
  notifications    Notification[]
  auditLogs        AuditLog[]
  archivedData     ArchivedUserData?

  @@map("users")
}

model UserBlock {
  id            Int      @id @default(autoincrement())
  blockerUserId Int
  blockedUserId Int
  createdAt     DateTime @default(now())
  blocker       User     @relation("BlockerUser", fields: [blockerUserId], references: [id])
  blocked       User     @relation("BlockedUser", fields: [blockedUserId], references: [id])

  @@unique([blockerUserId, blockedUserId])
  @@index([blockedUserId], map: "user_blocks_blocked_user_id_idx")
  @@map("user_blocks")
}

model Profile {
  id                            Int                   @id @default(autoincrement())
  userId                        Int                   @unique
  name                          String?
  gender                        Gender?
  dateOfBirth                   DateTime?
  maritalStatus                 MaritalStatus?
  motherTongue                  String?
  city                          String?
  state                         String?
  country                       String?
  highestEducation              String?
  bio                           String?
  profileCompletion             Int                   @default(10)
  profileStatus                 ProfileStatus         @default(INCOMPLETE)
  hasCompletedImageUpload       Boolean               @default(false)
  selfieUrl                     String?
  selfieStatus                  SelfieStatus?
  hasCompletedBasicDetails      Boolean               @default(false)
  hasCompletedPartnerPreference Boolean               @default(false)
  childrenStatus                ChildrenStatus?
  drinkingHabit                 DrinkingHabit?
  emotionalReadiness            EmotionalReadiness?
  languages                     String[]
  lookingFor                    LookingFor?
  relationshipTimeline          RelationshipTimeline?
  smokingHabit                  SmokingHabit?
  leftSelfieUrl                 String?
  rightSelfieUrl                String?
  lastLocationLat               Float?
  lastLocationLng               Float?
  jobId                         Int?
  swipesOnMe                    ProfileSwipe[]        @relation("ProfileMatches")
  job                           Job?                  @relation(fields: [jobId], references: [id])
  user                          User                  @relation(fields: [userId], references: [id])
  answers                       UserAnswer[]
  images                        UserImage[]

  @@index([gender, id(sort: Desc)], map: "profiles_discovery_gender_id_idx")
  @@index([dateOfBirth], map: "profiles_discovery_date_of_birth_idx")
  @@index([maritalStatus], map: "profiles_discovery_marital_status_idx")
  @@index([childrenStatus], map: "profiles_discovery_children_status_idx")
  @@index([smokingHabit], map: "profiles_discovery_smoking_habit_idx")
  @@index([drinkingHabit], map: "profiles_discovery_drinking_habit_idx")
  @@index([languages], type: Gin, map: "profiles_discovery_languages_gin_idx")
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "profiles_discovery_name_trgm_idx")
  @@map("profiles")
}

model PartnerPreference {
  id            Int             @id @default(autoincrement())
  userId        Int             @unique
  ageFrom       Int?
  ageTo         Int?
  maritalStatus MaritalStatus[]
  motherTongue  String[]
  user          User            @relation(fields: [userId], references: [id])

  @@map("partner_preferences")
}

model UserImage {
  id        Int      @id @default(autoincrement())
  imageUrl  String
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  profileId Int
  profile   Profile  @relation(fields: [profileId], references: [id])

  @@map("user_images")
}

model PrivacySettings {
  id              Int      @id @default(autoincrement())
  userId          Int      @unique
  privacyEnabled  Boolean  @default(false)
  blurredImageUrl String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  user            User     @relation(fields: [userId], references: [id])

  @@map("privacy_settings")
}

model ProfileSwipe {
  id              Int         @id @default(autoincrement())
  userId          Int
  targetProfileId Int
  action          SwipeAction
  createdAt       DateTime    @default(now())
  targetProfile   Profile     @relation("ProfileMatches", fields: [targetProfileId], references: [id])
  user            User        @relation("UserSwipes", fields: [userId], references: [id])

  @@map("profile_swipes")
}

model ImageAccessRequest {
  id              Int               @id @default(autoincrement())
  ownerUserId     Int
  requesterUserId Int
  status          ImageAccessStatus @default(PENDING)
  requestedAt     DateTime          @default(now())
  respondedAt     DateTime?
  revokedAt       DateTime?
  revokedByUserId Int?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  owner           User              @relation("ReceivedRequests", fields: [ownerUserId], references: [id], onDelete: Cascade)
  requester       User              @relation("SentRequests", fields: [requesterUserId], references: [id], onDelete: Cascade)

  @@unique([ownerUserId, requesterUserId])
  @@index([ownerUserId, status])
  @@index([requesterUserId, status])
  @@map("image_access_requests")
}

model ProfileSection {
  id        Int               @id @default(autoincrement())
  key       String            @unique
  title     String
  orderNo   Int               @default(0)
  isPrimary Boolean           @default(false)
  questions ProfileQuestion[]

  @@map("profile_sections")
}

model ProfileQuestion {
  id         Int            @id @default(autoincrement())
  sectionId  Int
  question   String
  answerType AnswerType
  options    Json?
  minWords   Int?
  weight     Int            @default(1)
  isRequired Boolean        @default(true)
  orderNo    Int            @default(0)
  isActive   Boolean        @default(true)
  section    ProfileSection @relation(fields: [sectionId], references: [id])
  answers    UserAnswer[]

  @@map("profile_questions")
}

model UserAnswer {
  id         Int             @id @default(autoincrement())
  questionId Int
  answer     Json
  score      Int?
  createdAt  DateTime        @default(now())
  profileId  Int
  profile    Profile         @relation(fields: [profileId], references: [id])
  question   ProfileQuestion @relation(fields: [questionId], references: [id])

  @@unique([profileId, questionId])
  @@map("user_answers")
}

model Admins {
  id        Int      @id @default(autoincrement())
  username  String   @unique
  password  String
  role      Role     @default(ADMIN)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  assignedReports UserReport[]          @relation("ReportAssignedAdmin")
  moderationLogs  ModerationActionLog[] @relation("AdminModerationLogs")
  auditLogs       AuditLog[]

  @@map("admins")
}

model SubscriptionPlan {
  id                 Int                  @id @default(autoincrement())
  name               String               @unique
  price              Int
  durationDays       Int
  isActive           Boolean              @default(true)
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  isMostPopular      Boolean              @default(false)
  description        String?
  storeProductId     String?              @unique
  features           PlanFeature[]
  userSubscriptions  UserSubscription[]
  transactionHistory TransactionHistory[]

  @@map("subscription_plans")
}

model PlanFeature {
  id          Int              @id @default(autoincrement())
  planId      Int
  createdAt   DateTime         @default(now())
  limit       String
  featureKey  String
  updatedAt   DateTime         @updatedAt
  description String?
  plan        SubscriptionPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([planId, featureKey])
  @@map("plan_features")
}

model UserSubscription {
  id                     Int                @id @default(autoincrement())
  userId                 Int
  planId                 Int
  startDate              DateTime           @default(now())
  endDate                DateTime
  status                 SubscriptionStatus @default(ACTIVE)
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt
  nextPlanId             Int?
  willRenew              Boolean            @default(true)
  environment            String?
  lastEventTimestampMs   BigInt?
  originalTransactionId  String?            @unique
  revenueCatEventId      String?
  store                  String?
  cancelledAt            DateTime?
  billingIssueDetectedAt DateTime?
  planChangesAt          DateTime?
  refundedAt             DateTime?
  expiredAt              DateTime?
  /// Populated when status transitions to GRACE_PERIOD; after this date the
  /// reconciliation job will downgrade the user to FREE.
  gracePeriodEndsAt      DateTime?
  /// Updated every time /sync runs for this user.
  lastSyncedAt           DateTime?
  plan                   SubscriptionPlan   @relation(fields: [planId], references: [id], onDelete: Cascade)
  user                   User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([status, gracePeriodEndsAt]) // for reconciliation queries
  @@map("user_subscriptions")
}

model ProcessedRevenueCatEvent {
  id          String   @id
  type        String
  processedAt DateTime @default(now())

  @@map("processed_revenuecat_events")
}

/**
 * Append-only audit log for every subscription state change.
 * Never update or delete rows — only insert.
 * This is the source of truth for "why did this user's plan change?"
 */
model UserSubscriptionLog {
  id                    Int      @id @default(autoincrement())
  userId                Int
  previousPlanId        Int?
  newPlanId             Int?
  previousStatus        String?
  newStatus             String
  reason                String
  source                String
  eventType             String?
  eventId               String?
  productId             String?
  originalTransactionId String?
  transactionId         String?
  store                 String?
  environment           String?
  eventTimestampMs      BigInt?
  createdAt             DateTime @default(now())

  @@index([userId, createdAt])
  @@map("user_subscription_logs")
}

model TransactionHistory {
  id                    Int               @id @default(autoincrement())
  userId                Int
  planId                Int?
  status                TransactionStatus
  amount                Float?
  currency              String?
  revenueCatEventId     String?
  originalTransactionId String?
  store                 String?
  environment           String?
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt
  user                  User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan                  SubscriptionPlan? @relation(fields: [planId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@map("transaction_history")
}

model UserFeature {
  id                   Int      @id @default(autoincrement())
  userId               Int      @unique
  isProfileBlurEnabled Boolean  @default(false)
  maxInterests         Int      @default(0)
  maxVideoCallMinutes  Int      @default(0)
  maxAudioCallMinutes  Int      @default(0)
  maxMessages          Int      @default(0)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  audioCallMinutes     Int      @default(0)
  interests            Int      @default(0)
  messages             Int      @default(0)
  videoCallMinutes     Int      @default(0)
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_features")
}

model ImageAssets {
  id           Int                @id @default(autoincrement())
  section      ImageAssetsSection
  title        String
  imageUrl     String
  altText      String?
  redirectUrl  String?
  displayOrder Int                @default(0)
  isActive     Boolean            @default(true)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  @@index([section, isActive, displayOrder])
  @@map("image_assets")
}

model Job {
  id        Int       @id @default(autoincrement())
  name      String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  profiles  Profile[]

  @@index([name])
  @@map("jobs")
}

model Conversation {
  id        Int           @id @default(autoincrement())
  userOneId Int
  userTwoId Int
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  messages  ChatMessage[]
  userOne   User          @relation("ConversationUserOne", fields: [userOneId], references: [id])
  userTwo   User          @relation("ConversationUserTwo", fields: [userTwoId], references: [id])

  @@unique([userOneId, userTwoId])
  @@map("conversations")
}

model ChatMessage {
  id             Int          @id @default(autoincrement())
  conversationId Int
  senderId       Int
  content        String
  messageType    MessageType  @default(TEXT)
  zegoMessageId  String?
  createdAt      DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id])
  sender         User         @relation(fields: [senderId], references: [id])

  @@index([conversationId, createdAt])
  @@map("chat_messages")
}

model GuideCategory {
  id           Int      @id @default(autoincrement())
  name         String   @unique
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  guides       Guide[]

  @@map("guide_categories")
}

model Guide {
  id           Int           @id @default(autoincrement())
  question     String        @unique
  answer       String
  categoryId   Int
  bullets      String[]      @default([])
  displayOrder Int           @default(0)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  category     GuideCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  @@index([categoryId])
  @@map("guides")
}

enum ImageAccessStatus {
  PENDING
  APPROVED
  REJECTED
  REVOKED
  CANCELLED
}

enum Role {
  USER
  ADMIN
  SUPER_ADMIN
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum MaritalStatus {
  AWAITING_DIVORCE
  DIVORCED
  WIDOWED
  SEPARATED
}

enum ChildrenStatus {
  LIVING_WITH_ME
  NOT_LIVING_WITH_ME
  NO_CHILDREN
}

enum EmotionalReadiness {
  YES
  MOSTLY
  NOT_SURE
}

enum LookingFor {
  MARRIAGE
  LONG_TERM_RELATIONSHIP
  SERIOUS_COMPANIONSHIP
}

enum RelationshipTimeline {
  ZERO_TO_SIX_MONTHS
  SIX_TO_TWELVE_MONTHS
  NO_FIXED_TIMELINE
}

enum SmokingHabit {
  NEVER
  OCCASIONALLY
  SOCIALLY
  REGULARLY
}

enum DrinkingHabit {
  NEVER
  OCCASIONALLY
  SOCIALLY
  REGULARLY
}

enum SelfieStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ProfileStatus {
  INCOMPLETE
  ONBOARDING_COMPLETED
  COMPLETED
}

enum AnswerType {
  TEXT
  SINGLE_CHOICE
  MULTI_CHOICE
  RATING
  BOOLEAN
}

enum SwipeAction {
  LEFT
  RIGHT
  UP
}

enum SubscriptionStatus {
  ACTIVE
  INACTIVE
  CANCELLED
  CANCELLED_PENDING_EXPIRY
  /// Payment has failed; store is retrying. User retains access during store
  /// grace period. Transitions to GRACE_PERIOD or ACTIVE on recovery.
  BILLING_ISSUE
  /// Store grace period ended but RevenueCat not yet confirmed final expiry.
  /// Backend grants temporary access while reconciling against RC API.
  GRACE_PERIOD
  EXPIRED
}

enum TransactionStatus {
  PAID
  FAILED
  RENEWAL
  CANCELLED
  REFUNDED
}

enum InteractionState {
  NONE
  INTEREST_SENT
  INTEREST_RECEIVED
  MATCHED
}

enum ImageAssetsSection {
  ONBOARDING_SCREEN
  BANNERS
  ADS
  ONBOARDING
  ICON
}

enum MessageType {
  TEXT
  IMAGE
  AUDIO
  VIDEO
  CALL_LOG
}

model SocialAccount {
  id             Int      @id @default(autoincrement())
  userId         Int
  provider       String
  providerUserId String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerUserId])
  @@map("social_accounts")
}

model UserReport {
  id                    Int                   @id @default(autoincrement())
  reporterUserId        Int
  reportedUserId        Int
  reason                ReportReason
  description           String?
  evidenceScreenshots   String[]              @default([])
  source                ReportSource          @default(OTHER)
  relatedMessageId      Int?
  relatedConversationId Int?
  status                ReportStatus          @default(PENDING)
  priority              ReportPriority        @default(MEDIUM)
  assignedAdminId       Int?
  adminNotes            String?
  resolution            String?
  actionTaken           ModerationActionType?
  actionTakenAt         DateTime?
  actionTakenBy         Int?
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt

  reporterUser   User                  @relation("ReportedBy", fields: [reporterUserId], references: [id])
  reportedUser   User                  @relation("ReportTarget", fields: [reportedUserId], references: [id])
  assignedAdmin  Admins?               @relation("ReportAssignedAdmin", fields: [assignedAdminId], references: [id])
  moderationLogs ModerationActionLog[]

  @@index([status])
  @@index([reportedUserId])
  @@map("user_reports")
}

model ModerationActionLog {
  id        Int                  @id @default(autoincrement())
  userId    Int
  reportId  Int?
  adminId   Int
  action    ModerationActionType
  reason    String?
  notes     String?
  expiresAt DateTime?
  createdAt DateTime             @default(now())

  user   User        @relation("UserModerationLogs", fields: [userId], references: [id])
  admin  Admins      @relation("AdminModerationLogs", fields: [adminId], references: [id])
  report UserReport? @relation(fields: [reportId], references: [id])

  @@index([userId])
  @@map("moderation_action_logs")
}

enum ReportReason {
  FAKE_PROFILE
  IMPERSONATION
  INAPPROPRIATE_PHOTOS
  INAPPROPRIATE_MESSAGES
  HARASSMENT
  SPAM
  SCAM_OR_FRAUD
  ASKING_FOR_MONEY
  ABUSIVE_BEHAVIOR
  SEXUAL_CONTENT
  HATEFUL_CONTENT
  THREATS
  UNDERAGE_USER
  MARRIED_OR_FALSE_RELATIONSHIP_STATUS
  FALSE_INFORMATION
  OFF_PLATFORM_SOLICITATION
  OTHER
}

enum ReportSource {
  PROFILE
  CHAT
  PHOTO
  CALL
  OTHER
}

enum ReportStatus {
  PENDING
  UNDER_REVIEW
  RESOLVED
  DISMISSED
}

enum ReportPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum ModerationActionType {
  NONE
  WARNING
  CONTENT_REMOVED
  PROFILE_HIDDEN
  CHAT_RESTRICTED
  TEMPORARY_SUSPENSION
  PERMANENT_BAN
}

model DeviceToken {
  id         String         @id @default(uuid())
  userId     Int
  token      String         @unique
  platform   DevicePlatform
  deviceId   String?
  isActive   Boolean        @default(true)
  lastSeenAt DateTime       @default(now())
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("device_tokens")
}

enum DevicePlatform {
  ANDROID
  IOS
}

model Notification {
  id        Int       @id @default(autoincrement())
  userId    Int
  type      String
  title     String
  body      String
  data      Json?
  isRead    Boolean   @default(false)
  readAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, isRead])
  @@map("notifications")
}

enum ActorType {
  USER
  ADMIN
  SYSTEM
  WEBHOOK
  SUPER_ADMIN
}

enum AuditModule {
  AUTH
  PROFILE
  SUBSCRIPTION
  PAYMENT
  CHAT
  CALL
  MODERATION
  NOTIFICATION
  ACCOUNT
  ADMIN
  SYSTEM
}

enum AuditStatus {
  SUCCESS
  FAILED
  PENDING
  WARNING
}

enum AuditSeverity {
  INFO
  WARNING
  ERROR
  CRITICAL
}

enum AuditSource {
  API
  ADMIN
  WEBHOOK
  BACKGROUND_JOB
  MOBILE
  WEB
  OTHER
}

model AuditLog {
  id                Int           @id @default(autoincrement())
  userId            Int?
  adminId           Int?
  actorType         ActorType
  module            AuditModule
  action            String
  entityType        String?
  entityId          String?
  status            AuditStatus
  severity          AuditSeverity
  message           String
  oldValue          Json?
  newValue          Json?
  metadata          Json?
  requestId         String?
  correlationId     String?
  transactionId     String?
  revenueCatEventId String?
  source            AuditSource
  route             String?
  method            String?
  statusCode        Int?
  ipAddress         String?
  userAgent         String?
  device            String?
  environment       String?
  createdAt         DateTime      @default(now())

  user  User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  admin Admins? @relation(fields: [adminId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([userId, createdAt])
  @@index([correlationId])
  @@index([entityType, entityId])
  @@index([module, action])
  @@map("audit_logs")
}

enum DeletionRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

model ArchivedUserData {
  id               Int      @id @default(autoincrement())
  userId           Int      @unique
  originalEmail    String
  originalPhone    String?
  originalName     String?
  archivedAt       DateTime @default(now())
  reasonForArchive String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("archived_user_data")
}
